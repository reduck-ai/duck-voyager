{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"types": ["node", "vite/client"]
	},
	"include": ["*.ts", "tasks/**/*.ts", "replay/**/*.ts", "replay/**/*.svelte"]
}
